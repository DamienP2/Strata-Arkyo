[Unit]
Description=Strata Arkyo
Documentation=https://github.com/DamienP2/Strata-Arkyo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=strata
Group=strata
EnvironmentFile=-/etc/default/strata-arkyo
ExecStart=/opt/strata-arkyo/current/strata serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# Durcissement : le service n'écrit que dans son dossier de données.
# Le lot 2 (mises à jour OTA) ajoutera /opt/strata-arkyo aux chemins inscriptibles.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/strata-arkyo

[Install]
WantedBy=multi-user.target
