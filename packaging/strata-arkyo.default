# Réglages du service Strata Arkyo, lus par systemd au démarrage.
# Après modification : sudo systemctl restart strata-arkyo

# Dossier de données : base, fichiers déposés, sauvegardes.
STRATA_DATA_DIR=/var/lib/strata-arkyo

# Adresse et port d'écoute.
STRATA_LISTEN=0.0.0.0:8090

# Mises à jour : par défaut, les Releases GitHub du projet (rien à régler).
# « off » les désactive (mise à jour par fichier seulement) ; une autre source est possible.
#STRATA_UPDATE_URL=github:DamienP2/Strata-Arkyo

# Seulement si le dépôt GitHub devient privé : jeton en lecture seule (Contents: Read-only).
#STRATA_UPDATE_TOKEN=github_pat_...

# Secondes entre l'annonce d'un redémarrage aux utilisateurs et la bascule.
#STRATA_UPDATE_COUNTDOWN=60

# Cookies marqués Secure : à activer seulement si le site est servi en HTTPS.
#STRATA_SECURE_COOKIES=true

# Niveau de détail du journal (journalctl -u strata-arkyo).
#RUST_LOG=info
